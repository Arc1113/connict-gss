# Browser visual-QA binary evidence is generated locally; keep the Markdown index.
/docs/evidence/full-system-qa/*
!/docs/evidence/full-system-qa/*.md
/docs/evidence/**/*.png
/docs/evidence/**/*.zip
/docs/evidence/**/*.webm
/playwright-report/
/test-results/
/.browser-e2e-storage/
/.browser-e2e-results/

# Windows release payloads and installer binaries are generated from signed
# runtime inputs in CI. Never commit proprietary runtime binaries or releases.
/distribution/windows/payload/
/distribution/windows/runtime-input/
/distribution/windows/launcher/publish/
/distribution/windows/installer/Output/
/distribution/windows/runtime-input.zip
/distribution/windows/validation-evidence/

