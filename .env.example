APP_NAME="Graduation Stage System"
# Development defaults. For event deployment, copy .env.deployment.example and
# keep APP_DEBUG=false with APP_URL set to the server LAN address.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila
APP_BIND_HOST=127.0.0.1
APP_FORWARD_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_FORWARD_PORT=54329
DB_DATABASE=graduation_stage_system
DB_TEST_DATABASE=graduation_stage_system_testing
DB_USERNAME=gss_app
DB_PASSWORD=change-me
DB_SSLMODE=prefer

GSS_SEED_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240

REVERB_APP_ID=gss-local
REVERB_APP_KEY=replace-with-a-random-local-key
REVERB_APP_SECRET=replace-with-a-random-local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_FORWARD_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_BROWSER_HOST=
REVERB_BROWSER_PORT="${REVERB_FORWARD_PORT}"
REVERB_BROWSER_SCHEME=http

GSS_BACKUP_PATH=storage/app/gss-backups

# Preparation-only Azure Speech integration. Disabled by default. Keep the key
# blank in committed files and enable only on an approved preparation server.
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_CONNECT_TIMEOUT=5
AZURE_SPEECH_REQUEST_TIMEOUT=30
AZURE_SPEECH_MAX_RETRIES=3
AZURE_SPEECH_MAX_RESPONSE_BYTES=15728640
AZURE_SPEECH_MONTHLY_CHARACTER_BUDGET=500000
AZURE_SPEECH_BUDGET_WARNING_PERCENT=80

LOCAL_TTS_ENABLED=true
LOCAL_TTS_URL=http://local-tts:8880
LOCAL_TTS_CONNECT_TIMEOUT=2
LOCAL_TTS_REQUEST_TIMEOUT=90
LOCAL_TTS_MAX_RESPONSE_BYTES=15728640

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="graduation-stage@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
