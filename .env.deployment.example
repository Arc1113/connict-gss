APP_NAME="Graduation Stage System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://192.168.50.10
APP_TIMEZONE=Asia/Manila
APP_BIND_HOST=0.0.0.0
APP_FORWARD_PORT=8000
GSS_HTTPS_HOST=192.168.50.10
HTTP_FORWARD_PORT=80
HTTPS_FORWARD_PORT=443

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_FORWARD_PORT=54329
DB_DATABASE=graduation_stage_system
DB_TEST_DATABASE=graduation_stage_system_testing
DB_USERNAME=gss_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
CACHE_STORE=database

REVERB_APP_ID=gss-local
REVERB_APP_KEY=replace-with-a-random-local-key
REVERB_APP_SECRET=replace-with-a-random-local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_FORWARD_PORT=8080
REVERB_ALLOWED_ORIGINS=192.168.50.10
REVERB_BROWSER_HOST=
REVERB_BROWSER_PORT="${HTTPS_FORWARD_PORT}"
REVERB_BROWSER_SCHEME=https

GSS_BACKUP_PATH=storage/app/gss-backups

# Preparation-only and disabled during ceremony operation. Supply the real key
# only through the ignored deployment environment or approved secret handling.
AZURE_SPEECH_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_CONNECT_TIMEOUT=5
AZURE_SPEECH_REQUEST_TIMEOUT=30
AZURE_SPEECH_MAX_RETRIES=3
AZURE_SPEECH_MAX_RESPONSE_BYTES=15728640
AZURE_SPEECH_MONTHLY_CHARACTER_BUDGET=500000
AZURE_SPEECH_BUDGET_WARNING_PERCENT=80

LOCAL_TTS_ENABLED=true
LOCAL_TTS_URL=http://local-tts:8880
LOCAL_TTS_CONNECT_TIMEOUT=2
LOCAL_TTS_REQUEST_TIMEOUT=90
LOCAL_TTS_MAX_RESPONSE_BYTES=15728640

VITE_APP_NAME="${APP_NAME}"
MAIL_MAILER=log
