<service>
  <id>ConnictGSS-Reverb</id><name>Connict GSS Realtime</name>
  <description>Connict GSS local realtime event service.</description>
  <executable>%BASE%\..\runtime\frankenphp\php.exe</executable>
  <arguments>"%BASE%\..\app\artisan" reverb:start --host=127.0.0.1 --port=8080</arguments>
  <workingdirectory>%BASE%\..\app</workingdirectory>
  <env name="GSS_DATA_DIR" value="C:\ProgramData\ConnictGSS" /><env name="GSS_ENV_FILE" value="C:\ProgramData\ConnictGSS\configuration\runtime.env" />
  <logpath>C:\ProgramData\ConnictGSS\logs</logpath>
  <log mode="roll-by-size-time"><sizeThreshold>10485760</sizeThreshold><pattern>yyyy-MM-dd</pattern></log>
  <onfailure action="restart" delay="10 sec" />
</service>
